#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        pipemacro {
            bindings = <&kp PIPE>;
            key-positions = <42 43>;
        };

        resetleft {
            bindings = <&sys_reset>;
            key-positions = <38 39 40 41>;
        };

        resetright {
            bindings = <&sys_reset>;
            key-positions = <44 45 46 47>;
        };

        bootloaderleft {
            bindings = <&bootloader>;
            key-positions = <14 15 16 17>;
        };

        bootloaderright {
            bindings = <&bootloader>;
            key-positions = <18 19 20 21>;
        };
    };

    macros {
        january: january {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N1 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "JANUARY";
        };

        february: february {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N2 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "FEBRUARY";
        };

        march: march {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N3 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "MARCH";
        };

        april: april {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N4 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "APRIL";
        };

        may: may {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N5 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "MAY";
        };

        june: june {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N6 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "JUNE";
        };

        july: july {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N7 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "JULY";
        };

        august: august {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N8 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "AUGUST";
        };

        september: september {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N0 &kp N9 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "SEPTEMBER";
        };

        october: october {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N1 &kp N0 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "OCTOBER";
        };

        november: november {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N1 &kp N1 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "NOVEMBER";
        };

        december: december {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp SPACE &kp N1 &kp N2 &kp FSLH &kp N0 &kp N1 &kp SPACE &kp LS(R) &kp E &kp N &kp E &kp W &kp A &kp L &kp SPACE &kp PIPE>;
            label = "DECEMBER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Bas";
            bindings = <
&kp ESC         &kp N1          &kp N2          &kp N3            &kp N4       &kp N5                         &kp N6  &kp N7       &kp N8             &kp N9           &kp N0                   &kp MINUS
&kp TAB         &kp Q           &kp W           &kp E             &kp R        &kp T                          &kp Y   &kp U        &kp I              &kp O            &kp P                    &kp EQUAL
&kp F4          &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &kp G                          &kp H   &mt RCTRL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z           &kp X           &kp C             &kp V        &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M        &kp COMMA          &kp DOT          &kp FSLH                 &kp RIGHT_SHIFT
                                                &kp F2            &kp DELETE   &tog 1  &kp SPACE    &kp RET   &tog 2  &kp BSPC     &kp RGUI
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Low";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS     &kp BACKSLASH
&january    &february     &march        &april        &may          &june                           &kp GRAVE  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK  &kp F12
&july       &august       &september    &october      &november     &december                       &kp CARET  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH     &kp TILDE
&to 0       &trans        &trans        &trans        &trans        &trans        &to 0     &to 0   &trans     &kp MINUS     &kp NUMBER_0  &kp EQUAL     &kp PLUS      &to 0
                                        &trans        &trans        &trans        &trans    &trans  &trans     &trans        &trans
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Rai";
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                     &trans       &trans     &trans     &trans    &trans     &trans
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &kp N6       &kp N7     &kp N8     &kp N9    &kp N0     &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &trans       &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
&to 0   &trans  &trans  &trans   &trans   &trans   &to 0     &to 0   &kp KP_PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &to 0
                        &trans   &trans   &trans   &trans    &trans  &trans       &trans     &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
